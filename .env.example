APP_MODE=fixture
APP_ORIGIN=http://127.0.0.1:8000
DATABASE_URL=postgresql+psycopg://outreach:outreach@127.0.0.1:5432/outreach
# Run python scripts/bootstrap.py to generate these securely.
OPERATOR_PASSWORD_HASH=
TOKEN_ENCRYPTION_KEY=
SEND_ENABLED=false
X_CLIENT_ID=
X_CLIENT_SECRET=
X_CALLBACK_URL=http://127.0.0.1:8000/oauth/x/callback
# Stable numeric X IDs, comma separated. Never auto-populated by discovery.
TEST_RECIPIENT_IDS=
HISTORY_LIMIT_ACKNOWLEDGED=false
X_BUDGET_USD=5
MODEL_BUDGET_USD=1
DAILY_SEND_LIMIT=10
# template (no AI), openai, gemini or anthropic. See README, AI fit judging and drafting.
DRAFT_PROVIDER=template
# Optional Anthropic Messages integration; not required for template drafting.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
MODEL_DATA_USE_ACKNOWLEDGED=false

# OpenAI: the everyday model, and the stronger one used as backup and for "Rewrite".
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_STRONG_MODEL=gpt-6.1-terra
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest
# Model calls per UTC day, and drafts per sign-in.
AI_DAILY_CALL_LIMIT=200
DRAFT_LIMIT_PER_SESSION=40
# Who can be messaged. operator_approved (default): anyone the app finds, once you approve the exact text.
# test_allowlist: only accounts in TEST_RECIPIENT_IDS with recorded consent (for testing).
OUTREACH_POLICY=operator_approved
# Seconds between queued sends, and how often the background worker wakes.
SEND_MIN_GAP_SECONDS=120
QUEUE_TICK_SECONDS=30
# Minutes between automatic reply checks for 14 days after a send. 0 turns it off. See docs/COSTS.md.
AUTO_SYNC_MINUTES=180
